# Copier en .env (non versionné) et adapter.

PORT=3000

# URL publique du backend, utilisée pour construire les liens des photos
# stockées localement. Mettre l'IP du PC pour une démo sur téléphone réel.
# PUBLIC_BASE_URL=http://192.168.1.20:3000

# Stockage des photos : sans ces variables, les images sont écrites dans backend/uploads
# et servies par Express (mode démo local).
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=signalements

# Taille maximale d'une photo, en mégaoctets.
MAX_UPLOAD_SIZE_MB=5

# Base PostgreSQL / Supabase (branchement en cours, voir src/db).
# DATABASE_URL=
