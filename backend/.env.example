# Copier en .env (non versionné) et adapter.

PORT=3000

# URL publique du backend, utilisée pour construire les liens des photos
# stockées localement. Mettre l'IP du PC pour une démo sur téléphone réel.
# PUBLIC_BASE_URL=http://192.168.1.20:3000

# Stockage des photos : sans ces variables, les images sont écrites dans backend/uploads
# et servies par Express (mode démo local).
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=signalements

# Taille maximale d'une photo, en mégaoctets.
MAX_UPLOAD_SIZE_MB=5

# --- OBLIGATOIRE : base PostgreSQL / Supabase ---
# Sans cette variable, toutes les routes de l'API échouent (500) et /health renvoie 503.
# Supabase : Project Settings > Database > Connection string > URI
# Puis, une seule fois : npm run db:init
# Utiliser l'URL du POOLER (onglet « Session pooler ») : la connexion directe
# db.<ref>.supabase.co n'est joignable qu'en IPv6 et échoue sur la plupart des réseaux.
DATABASE_URL=postgresql://postgres.<ref-projet>:MOT_DE_PASSE@aws-0-<region>.pooler.supabase.com:6543/postgres

# Clé exigée pour agir au nom de l'ADMIN sur les endpoints de résolution.
# Si elle est absente, le rôle ADMIN est accepté sans contrôle (pratique en salle de TP,
# à définir pour une démonstration publique).
# TATITRA_ADMIN_KEY=

# Certificat d'autorité de la base, pour vérifier réellement TLS (Supabase :
# Project Settings > Database > SSL configuration). Sans lui, TLS reste actif mais non vérifié.
# DATABASE_CA_CERT=./certs/prod-ca.crt

# Met à 1 pour désactiver le job horaire J+7 (tests, environnement sans cron).
# DISABLE_CRON=0
