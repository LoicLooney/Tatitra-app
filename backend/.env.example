# Copier vers .env (local, non versionné) et remplir les valeurs.

PORT=3000

# Supabase Storage
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_xxx
SUPABASE_BUCKET=signalements
MAX_UPLOAD_SIZE_MB=5

# PostgreSQL (préférer le pooler IPv4)
DATABASE_PASSWORD=your_db_password
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
