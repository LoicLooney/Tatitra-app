<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        HTTPS partout (NF-05). Seules les adresses de développement local restent
        joignables en HTTP : backend lancé sur le PC (10.0.2.2 = hôte vu de l'émulateur).
        Pour une démo sur téléphone réel via Wi-Fi, la variante debug
        (app/src/debug/res/xml/network_security_config.xml) autorise le HTTP local.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
